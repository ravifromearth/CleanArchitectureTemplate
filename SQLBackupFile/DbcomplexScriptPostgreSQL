-- fn_calculate_order_discount(@SubTotal, @UserRole) RETURNS decimal(18,2)
CREATE OR REPLACE FUNCTION public.fn_calculate_order_discount(sub_total numeric(18,2), user_role text)
RETURNS numeric(18,2)
LANGUAGE plpgsql
AS $$
DECLARE
  discount numeric(18,2) := 0;
BEGIN
  IF user_role = 'SuperAdmin' THEN
    discount := sub_total * 0.20;
  ELSIF user_role = 'Admin' THEN
    discount := sub_total * 0.15;
  ELSIF user_role = 'Moderator' THEN
    discount := sub_total * 0.10;
  ELSIF sub_total > 1000 THEN
    discount := sub_total * 0.05;
  END IF;
  RETURN discount;
END;
$$;

-- fn_calculate_user_lifetime_value(@UserId) RETURNS decimal(18,2)
CREATE OR REPLACE FUNCTION public.fn_calculate_user_lifetime_value(p_user_id uuid)
RETURNS numeric(18,2)
LANGUAGE sql
AS $$
  SELECT COALESCE(SUM(o.total), 0)::numeric(18,2)
  FROM public.orders o
  WHERE o.user_id = p_user_id
    AND o.status IN ('Delivered','Processing','Shipped');
$$;

-- fn_get_product_average_rating(@ProductId) RETURNS decimal(3,2)
CREATE OR REPLACE FUNCTION public.fn_get_product_average_rating(p_product_id uuid)
RETURNS numeric(3,2)
LANGUAGE sql
AS $$
  SELECT COALESCE(AVG(pr.rating)::numeric(3,2), 0::numeric(3,2))
  FROM public.product_reviews pr
  WHERE pr.product_id = p_product_id
    AND pr.status = 'Approved';
$$;

-- fn_get_user_order_history(@UserId, @FromDate, @ToDate) RETURNS TABLE (...)
CREATE OR REPLACE FUNCTION public.fn_get_user_order_history(
  p_user_id uuid,
  p_from_date timestamp DEFAULT NULL,
  p_to_date timestamp DEFAULT NULL
)
RETURNS TABLE (
  id uuid,
  order_number varchar,
  created_at timestamp,
  status text,
  payment_method text,
  total numeric(18,2),
  item_count bigint,
  total_quantity bigint
)
LANGUAGE sql
AS $$
  SELECT 
    o.id,
    o.order_number,
    o.created_at,
    o.status,
    o.payment_method,
    o.total,
    COUNT(oi.id) AS item_count,
    COALESCE(SUM(oi.quantity),0) AS total_quantity
  FROM public.orders o
  LEFT JOIN public.order_items oi ON o.id = oi.order_id
  WHERE o.user_id = p_user_id
    AND (p_from_date IS NULL OR o.created_at >= p_from_date)
    AND (p_to_date   IS NULL OR o.created_at <= p_to_date)
  GROUP BY o.id, o.order_number, o.created_at, o.status, o.payment_method, o.total;
$$;

-- fn_get_top_selling_products(@TopN, @FromDate, @ToDate) RETURNS TABLE (...)
CREATE OR REPLACE FUNCTION public.fn_get_top_selling_products(
  p_top_n integer DEFAULT 10,
  p_from_date timestamp DEFAULT NULL,
  p_to_date timestamp DEFAULT NULL
)
RETURNS TABLE (
  product_id uuid,
  product_name varchar,
  sku varchar,
  price numeric(18,4),
  times_sold bigint,
  total_quantity_sold bigint,
  total_revenue numeric,
  average_selling_price numeric
)
LANGUAGE sql
AS $$
  SELECT
    p.id AS product_id,
    p.name AS product_name,
    p.sku,
    p.price,
    COUNT(oi.id) AS times_sold,
    SUM(oi.quantity) AS total_quantity_sold,
    SUM(oi.total_price) AS total_revenue,
    AVG(oi.unit_price) AS average_selling_price
  FROM public.products p
  JOIN public.order_items oi ON p.id = oi.product_id
  JOIN public.orders o ON oi.order_id = o.id
  WHERE (p_from_date IS NULL OR o.created_at >= p_from_date)
    AND (p_to_date   IS NULL OR o.created_at <= p_to_date)
    AND o.status IN ('Processing','Shipped','Delivered')
  GROUP BY p.id, p.name, p.sku, p.price
  ORDER BY total_quantity_sold DESC
  LIMIT GREATEST(p_top_n, 0);
$$;

-- fn_get_products_low_on_stock(@Threshold) RETURNS TABLE (...)
CREATE OR REPLACE FUNCTION public.fn_get_products_low_on_stock(p_threshold integer DEFAULT 20)
RETURNS TABLE (
  product_id uuid,
  product_name varchar,
  sku varchar,
  product_status text,
  warehouse_code varchar,
  quantity integer,
  available_quantity integer,
  reserved_quantity integer,
  last_restocked timestamp
)
LANGUAGE sql
AS $$
  SELECT 
    p.id,
    p.name,
    p.sku,
    p.status,
    pi.warehouse_code,
    pi.quantity,
    pi.available_quantity,
    pi.reserved_quantity,
    pi.last_restocked
  FROM public.products p
  JOIN public.product_inventories pi ON p.id = pi.product_id
  WHERE COALESCE(pi.available_quantity, 0) <= p_threshold
    AND p.status = 'Active'
    AND pi.status = 'InStock';
$$;

-- fn_get_user_activity_summary(@UserId) RETURNS TABLE (...)
CREATE OR REPLACE FUNCTION public.fn_get_user_activity_summary(p_user_id uuid)
RETURNS TABLE (
  user_id uuid,
  total_orders bigint,
  total_spent numeric,
  total_reviews bigint,
  active_sessions bigint,
  last_activity timestamp,
  average_rating numeric
)
LANGUAGE sql
AS $$
  SELECT 
    p_user_id AS user_id,
    (SELECT COUNT(*) FROM public.orders o WHERE o.user_id = p_user_id) AS total_orders,
    (SELECT COALESCE(SUM(o.total),0) FROM public.orders o WHERE o.user_id = p_user_id AND o.status = 'Delivered') AS total_spent,
    (SELECT COUNT(*) FROM public.product_reviews pr WHERE pr.user_id = p_user_id) AS total_reviews,
    (SELECT COUNT(*) FROM public.user_sessions us WHERE us.user_id = p_user_id AND us.status = 'Active') AS active_sessions,
    (SELECT MAX(us.last_activity_at) FROM public.user_sessions us WHERE us.user_id = p_user_id) AS last_activity,
    (SELECT AVG(pr.rating)::numeric FROM public.product_reviews pr WHERE pr.user_id = p_user_id) AS average_rating;
$$;

